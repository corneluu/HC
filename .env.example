# Copy to .env.local for local work. In production these are GitHub repository variables.

# Path the site lives under. Use "/" with a custom domain.
NEXT_PUBLIC_BASE_PATH=/corul-harmonia-christi
# Public address without a trailing slash, used for the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://corneluu.github.io/corul-harmonia-christi

# Formspree form id (the part after /f/). Empty: the form shows the phone number instead.
NEXT_PUBLIC_FORMSPREE_ID=

# Supabase project URL and anon (public) key. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
